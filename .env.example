# Copy to .env and fill in. Never commit .env.

# Public name of the app; its DNS record must point at this server.
APP_DOMAIN=budget.example.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# Default admin, created on first start. Use a long random password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Optional: your Google email, so the admin can also sign in with Google.
ADMIN_EMAIL=

# Optional Google sign-in. Create a "Web application" OAuth client and add the
# redirect URI https://<APP_DOMAIN>/openid/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: let anyone with an email on these domains sign in with Google.
ALLOWED_DOMAINS=

# Only for `docker compose --profile api up -d` (HTTP API for curl).
API_DOMAIN=api.budget.example.com
# One or more keys, comma-separated: openssl rand -hex 32
API_KEYS=
# The server account the HTTP API signs in as (create it in the User directory).
API_USER=admin
API_PASSWORD=
# Only if that account's budgets are end-to-end encrypted.
API_KEY_PASSWORD=
