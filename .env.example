# Copy to .env and fill in. Never commit .env.

# The address people open in the browser. Use https:// when a proxy or load
# balancer terminates TLS in front of the app; Google sign-in needs it.
PUBLIC_URL=https://budget.example.com

# Where the app port is published. 127.0.0.1 = only a proxy on this host can
# reach it; 0.0.0.0 = reachable from the network (plain HTTP).
APP_BIND=127.0.0.1
APP_PORT=5006
# IP or CIDR of your reverse proxy as seen by the container, comma-separated.
# A proxy on this host reaches the app from the Docker gateway: 172.30.0.1
# Leave empty if clients connect directly.
TRUSTED_PROXIES=

# Default admin, created on first start. Use a long random password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Optional: your Google email, so the admin can also sign in with Google.
ADMIN_EMAIL=

# Optional Google sign-in. Create a "Web application" OAuth client and add the
# redirect URI <PUBLIC_URL>/openid/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: let anyone with an email on these domains sign in with Google.
ALLOWED_DOMAINS=

# Only for `docker compose --profile api up -d` (HTTP API for curl).
API_BIND=127.0.0.1
API_PORT=5007
# One or more keys, comma-separated: openssl rand -hex 32
API_KEYS=
# The server account the HTTP API signs in as (create it in the User directory).
API_USER=admin
API_PASSWORD=
# Only if that account's budgets are end-to-end encrypted.
API_KEY_PASSWORD=
